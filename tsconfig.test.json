// The type check of the suite, mise run types:test: the tests, the pack check, and the scaffold
// test, which node runs under its type stripping, and the lint's config, eslint.config.js, and the
// scaffold bin, bin/new.js, as JSDoc-checked JavaScript.
// The unit tier imports src/, which tsc checks here under the same options; the pack check imports
// the installed package by its name, which it types by hand. It checks and never emits.
// Adapted from spike-html-apps-tooling (7de95fe): tsconfig.test.json, its JavaScript the lint's
// config.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "rootDir": "."
  },
  "include": ["test/**/*.ts", "eslint.config.js", "bin/*.js"]
}
