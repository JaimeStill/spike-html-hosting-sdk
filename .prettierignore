# Prettier formats the code, the JSON, and the stylesheets only: its default run would also
# rewrite the Markdown, the YAML, and pnpm-lock.yaml. Every file is ignored, then every directory
# and the code, JSON, and CSS files are let back in. Prettier also skips what .gitignore lists.
# Adapted from spike-html-apps-foundation (d5037b4): .prettierignore, without its test fixtures.
# Adapted from spike-html-hosting-components (396e6d9): .prettierignore, with template/ ignored.
*
!*/
!*.js
!*.ts
!*.json
!*.css
# marathon working files.
.claude/plans/
.claude/briefs/
node_modules
# The template's files hold the scaffold's tokens; the scaffold test checks a scaffolded copy's
# format with the copy's own check.
template/
# The copied syntax themes, byte for byte as their source holds them (src/syntax/*/content.json,
# and the Noctis fixture's syntax/*/content.json).
src/syntax/*/content/
test/fixtures/noctis/syntax/*/content/
