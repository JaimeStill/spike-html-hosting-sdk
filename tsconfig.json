// The build, src/ into dist/: tsc emits each module's .js and .d.ts, rewriting the sources' .ts
// specifiers to .js; scripts/build.sh copies the files a site reads as they are beside them. mise
// run types:src checks the same sources with --noEmit. skipLibCheck: the declarations the ESLint
// packages ship name types they don't install.
// Adapted from spike-html-apps-tooling (c598810): tsconfig.json, with skipLibCheck.
{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": ["src"]
}
